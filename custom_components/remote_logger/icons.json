        "default": "mdi:cloud-alert-outline"
      },
      "events": {
        "default": "mdi:text-box-multiple-outline"
      },
      "postings": {
        "default": "mdi:cloud-upload-outline"
      }
    }
  },
  "services": {
    "send_log": {
      "service": "mdi:message-plus-outline"
    },
    "flush": {
      "service": "mdi:upload-multiple"
    },
    "last_log": {
      "service": "mdi:history"
    }
  }
}
